# /etc/dolmus-takip/app.env  (root:dolmus-takip, 0640)
# Gizli değer içermez; yine de gerçek dosya Git'e girmez. APP_ORIGIN,
# HOSTNAME ve PORT burada TANIMLANMAZ: birincisi domain.env'den, ikisi
# servis dosyasından gelir.
DOLMUS_DB_PATH=/var/lib/dolmus-takip/data/app.sqlite
# Next yalnız 127.0.0.1'de dinlediği için ona ulaşan her bağlantı Caddy'dendir.
TRUSTED_PROXY=127.0.0.1
