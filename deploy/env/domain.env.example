# /etc/dolmus-takip/domain.env  (root:dolmus-takip, 0640)
# Alan adının TEK kaynağı: Caddy ({$DOLMUS_DOMAIN}) ve uygulama servisi
# (APP_ORIGIN=https://$DOLMUS_DOMAIN) bu dosyayı okur. Şema (https://),
# yol ve sondaki "/" YAZILMAZ; yalnız alan adı. Örnek değer gerçek kuruluma
# olduğu gibi kopyalanmaz.
DOLMUS_DOMAIN=dolmus-takip.ornek-alan-adi.com
