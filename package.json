{
  "name": "dolmus-takip",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "next build && node scripts/prepare-standalone.ts && playwright test",
    "db:init": "node --env-file-if-exists=.env scripts/db-init.ts",
    "db:generate": "drizzle-kit generate",
    "db:seed-dev": "node --env-file-if-exists=.env scripts/db-seed-dev.ts"
  },
  "dependencies": {
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "drizzle-orm": "0.45.2",
    "better-sqlite3": "13.0.3",
    "argon2": "0.45.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "drizzle-kit": "0.31.10",
    "tailwindcss": "4.3.3",
    "@tailwindcss/postcss": "4.3.3",
    "vitest": "5.0.1",
    "@playwright/test": "1.63.0",
    "eslint": "10.10.0",
    "eslint-config-next": "16.3.5",
    "@types/node": "22.20.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/better-sqlite3": "9.6.0"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "argon2@0.45.1": true,
    "better-sqlite3@13.0.3": true,
    "unrs-resolver@1.12.2": true
  }
}
